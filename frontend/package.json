{
  "name": "halal-recipe-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "generate:seo": "node scripts/generate-sitemap.mjs && node scripts/generate-seo-manifest.mjs",
    "prebuild": "npm run generate:seo",
    "build": "vite build",
    "preview": "vite preview",
    "test:lookup": "node --test src/lib/lookup/__tests__/lookupCache.test.js",
    "test:recipe": "node --test src/lib/recipe/__tests__/recipeConversionModel.test.js",
    "test:confidence": "node --test ../shared/contracts/__tests__/confidenceV1.test.js ../shared/contracts/__tests__/recipeConfidence.test.js",
    "test:monetization": "node --test src/lib/monetization/__tests__/monetization.consolidation.test.js src/lib/monetization/__tests__/config.test.js",
    "test:regression": "node --test ../shared/regression/__tests__/contractValidators.test.js src/lib/regression/__tests__/regression.frontend.test.js src/lib/savedRecipes/__tests__/localStorage.test.js"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.2",
    "@vitejs/plugin-react": "^5.1.2",
    "axios": "^1.13.2",
    "html2canvas": "^1.4.1",
    "lucide-react": "^0.562.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-helmet-async": "^2.0.5",
    "react-router-dom": "^7.12.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "vite": "^5.3.0"
  }
}
